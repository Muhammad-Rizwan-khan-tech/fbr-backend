# ==============================================================================
# FBR Invoice Cloud - Production Frontend Dockerfile (Multi-stage)
# ==============================================================================
FROM node:20-alpine as builder

WORKDIR /app

# Cache dependencies
COPY frontend/package*.json ./
RUN npm ci

# Copy source and build static artifacts
COPY frontend/ ./
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# --- Runtime Stage (Lightweight Nginx Alpine) ---
FROM nginx:1.25-alpine as runner

WORKDIR /usr/share/nginx/html

# Clean default Nginx assets and copy production build
RUN rm -rf ./*
COPY --from=builder /app/dist .

# Copy dedicated frontend Nginx virtual host configuration
COPY deploy/nginx/frontend-nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
