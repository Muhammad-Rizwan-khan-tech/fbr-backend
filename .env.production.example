# ==============================================================================
# FBR Invoice Cloud — Production Environment Configuration (.env.production)
# ==============================================================================
# IMPORTANT: Generate high-entropy cryptographically secure secrets before deploying.
# Linux/macOS: openssl rand -hex 32
# Windows PowerShell: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))

# --- Environment & Application ---
APP_ENV=production
PROJECT_NAME="FBR Invoice Cloud"
PROJECT_VERSION="1.1.0"
LOG_LEVEL=INFO
SERVICE_NAME=fbr-invoice-api

# --- Security & Credentials ---
# Must be >= 32 characters high-entropy secret
SECRET_KEY=replace-with-a-64-character-hex-string-from-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=https://fbr-invoice.company.com,https://app.fbr-invoice.company.com
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
SUBMIT_RATE_LIMIT_PER_MINUTE=120
METRICS_TOKEN=replace-with-prometheus-bearer-token-for-scraper

# --- PostgreSQL Production Database ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://fbr_app_prod:StrongProdPostgresPassword_2026@postgres:5432/fbr_invoice_cloud_prod
POSTGRES_DB=fbr_invoice_cloud_prod
POSTGRES_USER=fbr_app_prod
POSTGRES_PASSWORD=StrongProdPostgresPassword_2026
DB_AUTO_CREATE=false

# --- Redis Queue & Cache ---
REDIS_PASSWORD=StrongProdRedisAuthPassword_2026
REDIS_URL=redis://:StrongProdRedisAuthPassword_2026@redis:6379/0
CELERY_BROKER_URL=redis://:StrongProdRedisAuthPassword_2026@redis:6379/1
CELERY_RESULT_BACKEND=redis://:StrongProdRedisAuthPassword_2026@redis:6379/2
QUEUE_BACKEND=celery
JOB_STALE_SECONDS=900
QUEUED_REDISPATCH_SECONDS=120

# --- FBR Production Integration ---
# CAUTION: Production credentials submit genuine legal tax invoices to FBR!
FBR_ENVIRONMENT=PRODUCTION
FBR_PROVIDER=PRODUCTION
FBR_API_URL=https://gw.fbr.gov.pk/imfs/v1/invoices
FBR_API_KEY=fbr_live_client_api_key_assigned_by_pral
FBR_CLIENT_ID=fbr_production_pos_id_or_client_id
FBR_CLIENT_SECRET=fbr_production_pos_secret
FBR_HTTP_TIMEOUT_SECONDS=20.0
FBR_MAX_ATTEMPTS=4
FBR_RETRY_DELAYS_SECONDS=300,900,1800
FBR_STATUS_POLL_SECONDS=60

# --- Document Storage (S3 / MinIO / Cloudflare R2 / AWS) ---
STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_BUCKET=fbr-invoice-documents-prod
OBJECT_STORAGE_ACCESS_KEY=AKIA_PROD_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=PROD_SECRET_KEY_HASHED
SIGNED_URL_TTL_SECONDS=300
PUBLIC_API_BASE_URL=https://fbr-invoice.company.com

# --- Email Notifications (Production SMTP or SendGrid/SES HTTP) ---
EMAIL_PROVIDER=smtp
EMAIL_FROM=invoicing@fbr-invoice.company.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SG.your_production_sendgrid_key
SMTP_USE_TLS=true
