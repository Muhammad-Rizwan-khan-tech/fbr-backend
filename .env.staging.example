# ==============================================================================
# FBR Invoice Cloud — Staging Environment Configuration (.env.staging)
# ==============================================================================
# --- Environment & Application ---
APP_ENV=staging
PROJECT_NAME="FBR Invoice Cloud (Staging)"
PROJECT_VERSION="1.1.0"
LOG_LEVEL=DEBUG
SERVICE_NAME=fbr-invoice-api-staging

# --- Security & Credentials ---
SECRET_KEY=replace-with-a-64-character-hex-string-for-staging-environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://staging.fbr-invoice.company.com
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=30
SUBMIT_RATE_LIMIT_PER_MINUTE=180
METRICS_TOKEN=staging-metrics-bearer-token

# --- PostgreSQL Staging Database ---
DATABASE_URL=postgresql://fbr_app_staging:StagingPostgresPassword_2026@postgres:5432/fbr_invoice_cloud_staging
POSTGRES_DB=fbr_invoice_cloud_staging
POSTGRES_USER=fbr_app_staging
POSTGRES_PASSWORD=StagingPostgresPassword_2026
DB_AUTO_CREATE=false

# --- Redis Queue & Cache ---
REDIS_PASSWORD=StagingRedisPassword_2026
REDIS_URL=redis://:StagingRedisPassword_2026@redis:6379/0
CELERY_BROKER_URL=redis://:StagingRedisPassword_2026@redis:6379/1
CELERY_RESULT_BACKEND=redis://:StagingRedisPassword_2026@redis:6379/2
QUEUE_BACKEND=celery
JOB_STALE_SECONDS=600
QUEUED_REDISPATCH_SECONDS=60

# --- FBR Sandbox Integration (Pre-production Certification) ---
FBR_ENVIRONMENT=SANDBOX
FBR_PROVIDER=SANDBOX
FBR_API_URL=https://sandbox.fbr.gov.pk/imfs/v1/invoices
FBR_API_KEY=fbr_test_sandbox_api_key
FBR_CLIENT_ID=fbr_sandbox_pos_id
FBR_CLIENT_SECRET=fbr_sandbox_pos_secret
FBR_HTTP_TIMEOUT_SECONDS=15.0
FBR_MAX_ATTEMPTS=3
FBR_RETRY_DELAYS_SECONDS=60,180,300
FBR_STATUS_POLL_SECONDS=30

# --- Document Storage (MinIO / Staging S3) ---
STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT=https://minio.staging.company.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=fbr-invoice-documents-staging
OBJECT_STORAGE_ACCESS_KEY=MINIO_STAGING_KEY
OBJECT_STORAGE_SECRET_KEY=MINIO_STAGING_SECRET
SIGNED_URL_TTL_SECONDS=600
PUBLIC_API_BASE_URL=https://staging.fbr-invoice.company.com

# --- Email Notifications ---
EMAIL_PROVIDER=console
EMAIL_FROM=staging-noreply@fbr-invoice.company.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
